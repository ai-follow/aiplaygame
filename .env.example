AIPLAYGAME_HOST=127.0.0.1
AIPLAYGAME_PORT=8000
AIPLAYGAME_MATCH_DELAY_SECONDS=0.9

# Optional future model path. Keep large model files out of git.
AIPLAYGAME_MODEL_PATH=

# Optional OpenAI-compatible chat-completions endpoint for LLM players.
# Example: http://127.0.0.1:8001/v1/chat/completions
AIPLAYGAME_LLM_ENDPOINT=
AIPLAYGAME_LLM_API_KEY=
